{
  "name": "@ml-eom/user-service",
  "version": "0.1",
  "description": "Authentication service for machine learning project monitoring",
  "main": "dist/index.js",
  "author": "Rayane TOKO",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prod": "dotenvx run -f .env.production -f .env.production.local -- node dist/index.js",
    "dev": "dotenvx run -f .env.development -f .env.development.local -- tsx watch src/index.ts",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@fastify/cors": "^11.4.3",
    "fastify": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@ml-eom/tsconfigs": "workspace:*",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
